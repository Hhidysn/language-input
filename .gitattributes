# Line-ending policy.
# The app mandates LF for every file it WRITES; keep the repo consistent with that.
* text=auto

# Python / config / docs: LF everywhere
*.py      text eol=lf
*.qss     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.spec    text eol=lf
*.svg     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows shell scripts: LF as well -- the project standardised on LF (the
# settings app never preserves CRLF), so no CRLF exception is kept.
*.ps1     text eol=lf
*.bat     text eol=lf

# Binary assets
*.ico     binary
*.png     binary
